# Copy to .env (never commit it). All variables are optional in development.

# Where the API keeps its data.
# - Unset: a local PGlite folder (apps/api/data/pglite). Nothing to install.
# - A postgres:// URL: a real server, e.g. the docker-compose one or a hosted database.
#DATABASE_URL=postgres://nuenews:nuenews@localhost:5432/nuenews

# Login (Supabase Auth). Leave all of these out in local development: there is then no login
# and everything runs as one local user. In production the API refuses to start without
# SUPABASE_URL, so a missing setting can never leave it open.
#SUPABASE_URL=https://your-project.supabase.co
# Only for older Supabase projects that sign tokens with a shared secret (Project Settings, API,
# JWT secret). Newer projects publish public keys and need nothing here.
#SUPABASE_JWT_SECRET=
# The same project, for the browser. Both are public values: the anon key grants nothing by itself.
# They are baked in when the web app is built, so set them in the build environment.
#VITE_SUPABASE_URL=https://your-project.supabase.co
#VITE_SUPABASE_ANON_KEY=

# API port (the web dev server proxies /api to it).
#PORT=3000

# Sent to the sites we fetch from, so they can identify and contact us.
#USER_AGENT=NueNews/0.1 (personal dashboard)

# A long random string shared with the scheduled refresh job. Setting it turns on POST /internal/tick.
#CRON_SECRET=
