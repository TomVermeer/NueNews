# Copy to .env next to compose.yaml (never commit it, `chmod 600 .env` on the server).
# The values are the same ones Render uses; see docs/DEPLOYMENT-PLAN.md for where each comes from.

# Supabase "Session pooler" connection string (port 5432).
DATABASE_URL=
SUPABASE_URL=https://your-project.supabase.co
# Only for older Supabase projects that sign tokens with a shared secret. Otherwise leave empty.
SUPABASE_JWT_SECRET=

# The two public Supabase values for the web app (VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY)
# are not set here. They are baked into the image when it is built, on your PC.

# Optional. CRON_SECRET is not needed here: the container stays awake, so its own scheduler
# refreshes the feeds.
#USER_AGENT=NueNews/0.1 (personal dashboard)

# Optional. Use a published image instead of the one loaded by hand.
#NUENEWS_IMAGE=ghcr.io/<account>/nuenews:latest
